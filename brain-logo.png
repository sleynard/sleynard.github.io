<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>Opening Mind Over Matter…</title>
  <script>
    (function(){
      if(location.protocol === 'file:') return;
      const requestedRoute = location.pathname + location.search + location.hash;
      location.replace('/?__route=' + encodeURIComponent(requestedRoute));
    })();
  </script>
</head>
<body>
  <p>This helper page is ready to upload. It only redirects after it is placed on your website.</p>
  <noscript><p>Please return to <a href="/">Mind Over Matter</a> and enable JavaScript to open this article.</p></noscript>
</body>
</html>
